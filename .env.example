# Application Port
PORT=3000

# Node Environment
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Resend API Integration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public base URL this server is reachable at, used to build the logo image
# URL in verification emails. Optional — defaults to the current live
# deployment if unset; override only if the server moves to a new address.
APP_BASE_URL=http://localhost:3000
